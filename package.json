{
  "name": "armored-massage",
  "version": "0.1.0",
  "private": true,
  "description": "Webflow custom code for the Armored Massage site — modular JS/CSS, built with Vite and served from a Cloudflare Worker",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint 'src/**/*.js' 'worker/**/*.js'",
    "lint:css": "stylelint 'src/**/*.css'",
    "format": "prettier --write 'src/**/*.{js,css}' 'worker/**/*.js' '*.{js,json,md}'",
    "format:check": "prettier --check 'src/**/*.{js,css}' 'worker/**/*.js' '*.{js,json,md}'",
    "deploy": "export $(grep -v '^#' .env | xargs) && npm run build && wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royeyal/armored-massage.git"
  },
  "keywords": [
    "webflow",
    "vite",
    "cloudflare-workers",
    "gsap"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.6.2",
    "cssnano": "^9.9.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.32",
    "postcss-nesting": "^14.0.3",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "terser": "^5.51.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.2"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  }
}
